[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/home/agv/yz-aim-controller

# ★ 在正式啟動前等待 RS485 USB 裝置出現
ExecStartPre=/bin/sh -c 'while [ ! -e "/dev/serial/by-id/usb-FTDI_FT232R_USB_UART_BG028CF0-if00-port0" ]; do echo "[esp32-modbus] 等待 RS485 [>

# ★ 主程式
ExecStart=/home/agv/yz-aim-controller/venv/bin/python /home/agv/yz-aim-controller/esp32_modbus.py

# ★ 如果 service 因錯誤退出就自動重啟
Restart=always
RestartSec=1

Environment=PYTHONUNBUFFERED=1
